# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://rugpull.example

# --- The token -----------------------------------------------------------
# Leave unset until deployed. With it unset the site is honestly pre-launch:
# no market cap is read, the buy button is disabled, and nothing is
# happening — as promised.
NEXT_PUBLIC_RUG_TOKEN_ADDRESS=
# Where the buy button goes (DEX swap link). Button stays disabled while unset.
NEXT_PUBLIC_RUG_BUY_URL=
# ISO date of launch. Starts the "time during which nothing happened" clock.
NEXT_PUBLIC_RUG_LAUNCHED_AT=
# Optional display string for total supply, e.g. 1,000,000,000
NEXT_PUBLIC_RUG_TOTAL_SUPPLY=

# --- The number ----------------------------------------------------------
# Market cap is read live from DexScreener for the token address above.
# Optionally pin the lookup to one chain slug (leave unset to take the
# deepest pair on any chain).
NEXT_PUBLIC_RUG_DEX_CHAIN_ID=
# Manual market cap in USD. Overrides the live feed when set — for demos,
# for a chain the feed does not index yet, or for the day the feed is down.
NEXT_PUBLIC_RUG_MARKETCAP_USD=
# Flip to true after the rug. Market cap collapses the moment it happens,
# and without this the page would report that nothing is happening again.
NEXT_PUBLIC_RUG_RUGGED=false

# --- Chain (defaults in src/lib/chain.ts, re-verify before mainnet) ------
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Wallets ---------------------------------------------------------------
# Browser wallets (MetaMask, Rabby, Coinbase…) connect with nothing set.
# A WalletConnect Cloud project id adds a QR / mobile option to the panel.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Socials (hidden from the footer while unset) -----------------------
NEXT_PUBLIC_RUG_X=
NEXT_PUBLIC_RUG_TELEGRAM=
